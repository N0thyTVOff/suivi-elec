{
  "name": "wattelier",
  "productName": "Wattelier",
  "version": "2.4.3",
  "description": "Votre énergie, enfin claire — suivi local Linky, Sonoff/eWeLink et Omajin/Tuya",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "N0thyTVOff",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir --win x64",
    "desktop:build": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:validate": "node scripts/validate-windows-package.js",
    "icons": "node scripts/generate-icons.js",
    "dev": "concurrently -n server,web -c blue,green \"node server/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test --experimental-test-coverage --test-coverage-include=desktop/connection-store.js --test-coverage-include=desktop/login-item.js --test-coverage-include=desktop/policy.js --test-coverage-include=desktop/preferences.js --test-coverage-include=desktop/reset.js --test-coverage-include=desktop/runtime-paths.js --test-coverage-include=desktop/tailscale.js --test-coverage-include=desktop/update-policy.js --test-coverage-include=server/connection-token.js --test-coverage-include=server/http-utils.js --test-coverage-include=server/omajin/client.js --test-coverage-include=server/omajin/model.js --test-coverage-include=server/public-settings.js --test-coverage-include=server/token-utils.js --test-coverage-include=test/**/*.js --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-onboarding.js",
    "typecheck": "tsc --noEmit",
    "validate:repo": "node scripts/validate-repository.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate:repo && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "multicast-dns": "^7.2.5",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "echarts": "^6.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "lucide-react": "^1.28.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "yaml": "^2.9.0"
  }
}
