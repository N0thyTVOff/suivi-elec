# Compte eWeLink utilisé pour découvrir les prises Sonoff.
# Ne publiez jamais les valeurs réelles et utilisez si possible un compte dédié.
EWELINK_EMAIL=
EWELINK_PASSWORD=

# Région eWeLink : eu, us, as ou cn.
EWELINK_REGION=eu

# Prises Omajin OSP-FR-01 associées à un projet Cloud Tuya.
# Ces valeurs sont des secrets : ne les publiez jamais.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Centre de données : eu, eu-west, us, us-east, cn, in ou sg.
TUYA_REGION=eu

# Un ou plusieurs IDs Tuya, séparés par une virgule. Un nom peut suivre "=".
# Exemple : bf1234567890abcdef=Prise du salon
TUYA_DEVICE_IDS=

# Port HTTP local du tableau de bord.
PORT=3017

# Adresse d'écoute. 0.0.0.0 rend le serveur joignable sur le réseau local.
HOST=0.0.0.0

# Activez uniquement derrière un reverse proxy HTTPS correctement configuré.
TRUST_PROXY=0

# Répertoire SQLite et journaux (utile pour Docker ou les tests isolés).
DATA_DIR=./data
